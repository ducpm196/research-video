# ==============================================================================
# .gitignore — Hệ thống sản xuất & kiểm định bài giảng video (research-video)
# ==============================================================================

# ---------- 1. Python ----------
.venv/
.venv-*/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
wheels/
*.whl
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# ---------- 2. Node.js (KaTeX etc. trong tools/vendor) ----------
# package.json và package-lock.json của tools/vendor được GIỮ để tái lập môi trường
tools/vendor/node_modules/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 3. Phụ thuộc ngoài tải về cho bộ kiểm thực nghiệm (audit/bnx/deps) ----------
# Giữ lại README.md (ghi phiên bản, URL, sha256) và mã nguồn nhỏ (go.mod, go.sum, *.go);
# bỏ qua các thư viện nhị phân, vendor và môi trường ảo nặng tải từ Maven Central / PyPI / Go proxy.
audit/bnx/deps/**/*.jar
audit/bnx/deps/**/vendor/
audit/bnx/deps/**/venv/
*.jar
*.war
*.ear
*.class
*.exe
*.dll
*.so
*.dylib

# ---------- 4. Sản phẩm sinh ra (video, âm thanh, khung hình, cache) ----------
out/
*.mp4
*.mkv
*.webm
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.ogg

# ---------- 5. Mô hình AI / TTS / cache tải về ----------
.cache/
*.onnx
*.bin
*.pt
*.pth
*.ckpt
*.safetensors
models/
huggingface/
tools/vendor/piper/
audit/tts_fallback/

# ---------- 6. Nhật ký chạy cổng, hàng dựng nền & thư mục khoá nguyên tử ----------
*.log
*.out
audit/**/rebuild*.claims/
audit/**/*.claims/
out/_render.lock/

# ---------- 7. Bí mật, chứng chỉ & cấu hình cục bộ (An toàn thông tin) ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der
id_rsa*
id_ed25519*
secrets.*
credentials.*
.claude/settings.local.json
.gemini/settings.local.json

# ---------- 8. LaTeX build & tài liệu biên dịch ----------
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
*.bbl
*.blg
*.pdf

# ---------- 9. Editor / IDE / Hệ điều hành ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*~
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------- 10. Tệp tạm & sao lưu ----------
*.tmp
*.temp
*.bak
*.orig
tmp/
temp/
